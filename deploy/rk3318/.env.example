# ---------------------------------------------------------------------------
# RK3318 BOX 部署变量样例
#   cp deploy/rk3318/.env.example deploy/rk3318/.env   ← 真实文件不入库
# ---------------------------------------------------------------------------

# ---- 站点 ----
NODE_ENV=production
APP_URL=http://192.168.5.12:3000
TZ=Asia/Shanghai

# ---- 数据库 ----
# 盒子宿主已装 MySQL：容器内用 host.docker.internal 走 host-gateway
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=douyin_app
DB_PASSWORD=change_me
DB_NAME=douyin
# 用 --profile db 起容器内 MySQL 时改：DB_HOST=douyin-mysql
# 并补：MYSQL_ROOT_PASSWORD=change_me_root

# ---- 登录 / 会话 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
SESSION_SECRET=change_me_session_secret
JWT_SECRET=change_me_jwt_secret
API_TOKENS=change_me_api_token

# ---- 运行时目录（对应 compose 挂载卷，别指向容器内的临时层）----
BOT_STORAGE_DIR=/app/data/runtime
ARTIFACT_ROOT=/var/lib/douyin/artifacts
MIGRATION_LOCK_TIMEOUT_SECONDS=30

# ---- 机器人：盒子上默认内嵌启动微信 + QQ（多 QQ 机器人见 qq-bots 目录）----
PROJECT_BOTS=1

# ---- iLink（实验性，默认全关；启用前读 CLAUDE.md 第 1/4 节）----
BOT_ILINK_ENABLED=0
BOT_ILINK_DB_ENABLED=0
# BOT_RUNTIME_SECRET=at-least-16-chars
