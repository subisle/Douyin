# 网站服务器配置
NODE_ENV=development
APP_URL=http://localhost:3000

# 数据库配置（全部必填；缺项或端口无效时应用拒绝启动）
DB_HOST=127.0.0.1
# 也可使用受信任内网数据库地址
DB_PORT=3306
DB_USER=douyin_app
DB_PASSWORD=change_me
DB_NAME=douyin

# 网站后台密码（单密码登录，无账号；支持明文，或 sha256:<hash>；未配置时默认 200309）
ADMIN_PASSWORD=change_me_admin_password

# API Token：给 iOS App/自动化脚本等非网页客户端调用
API_TOKENS=change_me_dev_token

# 浏览器只使用 HttpOnly 登录会话，不在 NEXT_PUBLIC_* 中放置凭据。
# 独立前端可设置 API 地址；同域部署留空。
NEXT_PUBLIC_API_BASE_URL=

# 会话签名密钥（生产环境必须配置）
SESSION_SECRET=change_me_session_secret
JWT_SECRET=change_me_jwt_secret

# 说明：本项目已移除 AI 能力（无模型调用、无知识库、无会话记忆），
# 因此不再需要 AI_* / OPENAI_* 变量；机器人只处理固定指令。

# 本地/单机运行时目录与容量上限
BOT_STORAGE_DIR=./data/runtime
MIGRATION_LOCK_TIMEOUT_SECONDS=30

# Electron 安装包从用户数据目录的 douyin.env 读取同一组服务端变量；
# 也可在启动进程中设置 DOUYIN_ENV_PATH=/absolute/path/to/douyin.env。


# 网站进程是否内嵌启动微信 + QQ 机器人（npm run dev / npm start 默认开）
# 桌面 electron:dev 会设 PROJECT_BOTS=0，改由 Electron 托管，避免双边同时跑同一账号
# PROJECT_BOTS=1

# QQ 多机器人：每个机器人一份 JSON 配置
#   默认从 <内置配置目录>/qq-bots/*.json 读取（打包后即 resources/builtin-config/qq-bots）
#   也可用 QQ_BOTS_DIR 指向自定义目录；兼容单份 qq-bot.v1.json
#   配置内容：{ "appId": "...", "clientSecret": "...", "label": "可选备注" }
# QQ_BOTS_DIR=/srv/douyin/qq-bots

# 机器人存储文件位置（不设则优先用内置配置目录，其次运行时目录）
# WEIXIN_BOT_STORE=/app/data/builtin/weixin-bot.v1.json
# QQ_BOT_STORE=/app/data/builtin/qq-bot.v1.json
# 机器人本地凭据加密（不设则回退 SESSION_SECRET / JWT_SECRET）
# BOT_STORE_SECRET=change_me_bot_store_secret
