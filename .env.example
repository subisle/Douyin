# 网站服务器配置
NODE_ENV=development
APP_URL=http://localhost:3000

# 数据库配置（全部必填；缺项或端口无效时应用拒绝启动）
DB_HOST=127.0.0.1
# 也可使用受信任内网数据库地址
DB_PORT=3306
DB_USER=douyin_app
DB_PASSWORD=change_me
DB_NAME=douyin

# 网站后台账号密码（必须显式配置；支持明文，或 sha256:<hash>）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# API Token：给 iOS App/自动化脚本等非网页客户端调用
API_TOKENS=change_me_dev_token

# 浏览器只使用 HttpOnly 登录会话，不在 NEXT_PUBLIC_* 中放置凭据。
# 独立前端可设置 API 地址；同域部署留空。
NEXT_PUBLIC_API_BASE_URL=

# 会话签名密钥（生产环境必须配置）
SESSION_SECRET=change_me_session_secret
JWT_SECRET=change_me_jwt_secret

# Agent / iLink runtime（AI 默认关闭；启用前必须显式提供 HTTPS 服务和 Key）
AI_ENABLED=0
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# 本地/单机运行时目录与容量上限
BOT_STORAGE_DIR=./data/runtime
AGENT_SESSION_MAX_BYTES=20971520
AGENT_SESSION_MAX_SESSIONS=200
RAG_CUSTOM_MAX_BYTES=5242880
MIGRATION_LOCK_TIMEOUT_SECONDS=30

# Electron 安装包从用户数据目录的 douyin.env 读取同一组服务端变量；
# 也可在启动进程中设置 DOUYIN_ENV_PATH=/absolute/path/to/douyin.env。
