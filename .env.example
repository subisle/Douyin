# 网站服务器配置
NODE_ENV=development
APP_URL=http://localhost:3000

# 网站数据库（服务端/桌面端本地使用；不要提交真实密码，不要打进安装包）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=douyin_app
DB_PASSWORD=change_me
DB_NAME=douyin

# 网站后台账号密码（必须显式配置；支持明文，或 sha256:<hash>）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# API Token：给 iOS App/自动化脚本等非网页客户端调用
API_TOKENS=change_me_dev_token

# 远程客户端配置：独立前端或未来 App/WebView 可指向网站 API
# 同域部署可留空
NEXT_PUBLIC_API_BASE_URL=
# 如前端需要直接调用受保护写接口，可配置；生产上更推荐登录会话方式
NEXT_PUBLIC_API_TOKEN=

# 会话签名密钥（生产环境必须配置）
SESSION_SECRET=change_me_session_secret
JWT_SECRET=change_me_jwt_secret
