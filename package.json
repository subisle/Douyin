{
  "name": "douyin",
  "version": "0.1.26",
  "private": true,
  "packageManager": "npm@11.12.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src electron next.config.ts",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c yellow,cyan \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "cross-env ELECTRON=true next build",
    "dist": "npm run electron:build && electron-builder --mac --win --x64",
    "dist:mac": "npm run electron:build && electron-builder --mac",
    "dist:win": "npm run electron:build && electron-builder --win --x64",
    "poster:sync": "node scripts/sync-poster-from-psd.mjs",
    "poster:sync:meta": "node scripts/sync-poster-from-psd.mjs --skip-images"
  },
  "build": {
    "appId": "com.subisle.douyin",
    "productName": "抖音数据管理",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon",
    "artifactName": "douyin-data-manager-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "assets/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "douyin-data-manager"
    },
    "nsis": {
      "artifactName": "douyin-data-manager-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "subisle",
      "repo": "Douyin",
      "releaseType": "release"
    },
    "extraMetadata": {}
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.513.0",
    "mysql2": "^3.22.5",
    "next": "^15.3.4",
    "papaparse": "^5.5.3",
    "protobufjs": "^8.6.6",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
