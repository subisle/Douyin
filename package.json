{
  "name": "douyin",
  "version": "0.1.41",
  "private": true,
  "packageManager": "npm@11.12.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src electron shared next.config.ts",
    "check:release-baseline": "node scripts/check-release-baseline.mjs",
    "test": "npm run test:db-config && npm run test:auth && npm run test:imports && npm run test:migrations && npm run test:ilink-adapter && npm run test:bot-worker && npm run test:weixin-bot && npm run test:qq-bot",
    "test:db-config": "node --test electron/db-config.test.js electron/runtime-env.test.js electron/local-paths.test.js electron/live-pk-protocol.test.js electron/live-pk-multi-monitor.test.js",
    "smoke:live-protocol": "node scripts/smoke-live-protocol.mjs",
    "smoke:live-multi": "node scripts/smoke-live-multi.mjs",
    "test:auth": "node --test src/server/api/login-rate-limit.test.mjs src/server/api/csrf-origin.test.mjs",
    "test:imports": "node --test electron/db-import.test.js",
    "test:migrations": "node --test scripts/migration-runner.test.js",
    "test:ilink-adapter": "node --test shared/ilink-adapter.test.js",
    "test:ilink-db": "node --test scripts/ilink-crypto.test.js scripts/ilink-db-lease.test.js scripts/ilink-inbox-cursor.test.js scripts/ilink-outbox.test.js scripts/ilink-account-credentials.test.js scripts/ilink-login-control.test.js scripts/ilink-login-poller.test.js scripts/ilink-artifact-store.test.js scripts/ilink-media-policy.test.js",
    "test:bot-worker": "node --test scripts/bot-worker.test.js scripts/ilink-text-transport.test.js scripts/ilink-crypto.test.js scripts/ilink-db-lease.test.js scripts/ilink-inbox-cursor.test.js scripts/ilink-outbox.test.js scripts/ilink-account-credentials.test.js scripts/ilink-login-control.test.js scripts/ilink-login-poller.test.js scripts/ilink-artifact-store.test.js scripts/ilink-media-policy.test.js",
    "test:weixin-bot": "node --test electron/weixin-bot*.test.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c yellow,cyan \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "node scripts/electron-next-build.mjs",
    "dist": "npm run electron:build && electron-builder --mac --win --x64",
    "dist:mac": "npm run electron:build && electron-builder --mac",
    "dist:win": "npm run electron:build && electron-builder --win --x64",
    "poster:sync": "node scripts/sync-poster-from-psd.mjs",
    "poster:sync:meta": "node scripts/sync-poster-from-psd.mjs --skip-images",
    "bot:worker": "node scripts/bot-worker.js",
    "bot:seed-credential": "node scripts/ilink-seed-credential.js",
    "storage:bench": "node scripts/bench-local-storage.mjs",
    "storage:doctor": "node scripts/storage-doctor.mjs",
    "test:qq-bot": "node --test shared/qqbot-adapter.test.js electron/qq-bot.test.js"
  },
  "build": {
    "appId": "com.subisle.douyin",
    "productName": "抖音数据管理",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon",
    "artifactName": "douyin-data-manager-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "!electron/**/*.test.js",
      "!electron/**/*-test.js",
      "!electron/dist/**/*",
      "shared/**/*",
      "!shared/**/*.test.js",
      "!shared/**/*-test.js",
      "assets/**/*",
      "!assets/fonts/**/*",
      "!assets/posters/**/*",
      "data/rag/bot_help.json",
      ".env",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "douyin-data-manager"
    },
    "nsis": {
      "artifactName": "douyin-data-manager-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "subisle",
      "repo": "Douyin",
      "releaseType": "release"
    },
    "extraMetadata": {}
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.513.0",
    "mysql2": "^3.22.5",
    "next": "^15.5.21",
    "papaparse": "^5.5.3",
    "protobufjs": "^8.6.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "3.8.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "8.5.15",
    "js-yaml": "^4.3.0",
    "sharp": "$sharp",
    "shell-quote": "^1.10.0"
  }
}
